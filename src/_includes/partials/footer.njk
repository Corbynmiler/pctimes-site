<footer class="site-footer" role="contentinfo">
  <div class="container site-footer__grid">

    <div class="site-footer__brand">
      <p class="site-footer__name">{{ site.name }}</p>
      <p class="site-footer__tagline">{{ site.tagline }}</p>
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__heading">Navigate</h2>
      <ul class="site-footer__list">
        {% for item in nav.items %}
          <li><a href="{{ item.href }}">{{ item.label }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__heading">Contact</h2>
      <address class="site-footer__address">
        <a href="tel:{{ site.contact.phone_news | replace(' ', '') }}">{{ site.contact.phone_news }}</a> <span class="muted">({{ site.contact.phone_news_label | lower }})</span><br>
        <a href="tel:{{ site.contact.phone_advertising | replace(' ', '') }}">{{ site.contact.phone_advertising }}</a> <span class="muted">({{ site.contact.phone_advertising_label | lower }})</span><br>
        <br>
        <a href="mailto:{{ site.contact.email_news }}">{{ site.contact.email_news }}</a><br>
        <a href="mailto:{{ site.contact.email_advertising }}">{{ site.contact.email_advertising }}</a>
      </address>
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__heading">Follow</h2>
      <ul class="site-footer__list">
        {% if site.social.facebook %}<li><a href="{{ site.social.facebook }}" target="_blank" rel="noopener">Facebook</a></li>{% endif %}
        {% if site.social.instagram %}<li><a href="{{ site.social.instagram }}" target="_blank" rel="noopener">Instagram</a></li>{% endif %}
      </ul>
    </div>

  </div>

  <div class="container site-footer__base">
    <p class="site-footer__copyright">© {% year %} {{ site.publisher }}. All rights reserved.</p>
    <a class="site-footer__pill" href="{{ site.credit.url }}" target="_blank" rel="noopener">
      Need a site for your business? <span aria-hidden="true">→</span>
    </a>
  </div>
</footer>
