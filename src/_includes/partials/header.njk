<header class="site-header" role="banner">

  {# Future top banner ad — only renders if site.top_ad.image is set. #}
  {% if site.top_ad and site.top_ad.image %}
    <div class="site-header__ad">
      <div class="container">
        {% if site.top_ad.url %}<a href="{{ site.top_ad.url }}" target="_blank" rel="noopener">{% endif %}
          <img src="{{ site.top_ad.image }}" alt="{{ site.top_ad.alt or 'Advertisement' }}" loading="lazy">
        {% if site.top_ad.url %}</a>{% endif %}
      </div>
    </div>
  {% endif %}

  {# Masthead: logo centred. Big and dominant on desktop, scaled on mobile. #}
  <div class="site-header__masthead">
    <div class="container">
      <a href="/" class="site-header__brand" aria-label="{{ site.name }} — home">
        <img src="/assets/images/logo.png" alt="{{ site.name }}" class="site-header__logo" width="800" height="160">
      </a>
    </div>
  </div>

  {# Mobile menu button sits directly underneath the logo, centred. Hidden on desktop. #}
  <div class="site-header__menubar">
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Open menu">
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__label">Menu</span>
    </button>
  </div>

</header>

{# Primary nav lives OUTSIDE the header so it can sticky-stick to the viewport
   while the masthead scrolls away on desktop. Sticky only works inside an
   ancestor that extends down the scrolling area — i.e. <body>, not the
   short-height <header>. #}
<nav id="primary-nav" class="site-nav" aria-label="Primary">
  <ul class="site-nav__list">
    {% for item in nav.items %}
      <li class="site-nav__item">
        <a
          href="{{ item.href }}"
          class="site-nav__link{% if page.url == item.href %} is-current{% endif %}"
          {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a>
      </li>
    {% endfor %}
  </ul>
</nav>
