---
layout: layouts/base.njk
permalink: /latest-issue/
title: "Latest Issue"
description: "Read this week's Pōhutukawa Coast Times online — free PDF of the latest edition."
bodyClass: "latest"
---

<section class="page-header section">
  <div class="container">
    <p class="eyebrow">PC Times Online</p>
    <h1>Issue {{ latest.issue_number }} — {{ latest.date | formatDate }}</h1>
    {% if latest.blurb %}<p class="page-header__lede">{{ latest.blurb }}</p>{% endif %}

    <div class="pdf-actions">
      {% if latest.flipbook_url %}
        <a class="btn btn--primary" href="{{ latest.flipbook_url }}" target="_blank" rel="noopener">Read online ↗</a>
        <a class="btn btn--ghost" href="{{ latest.pdf }}" target="_blank" rel="noopener">Open PDF ↗</a>
        <a class="btn btn--link" href="{{ latest.pdf }}" download>Download PDF</a>
      {% else %}
        <a class="btn btn--primary" href="{{ latest.pdf }}" target="_blank" rel="noopener">Open PDF ↗</a>
        <a class="btn btn--ghost" href="{{ latest.pdf }}" download>Download PDF</a>
      {% endif %}
    </div>
  </div>
</section>

{% if latest.in_this_issue and latest.in_this_issue.length %}
<section class="in-this-issue section">
  <div class="container container--narrow">
    <h2>In this issue</h2>
    <ul class="in-this-issue__list" role="list">
      {% for item in latest.in_this_issue %}
        <li>{{ item }}</li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}

<section class="pdf-viewer section">
  <div class="container">
    {% if latest.flipbook_url %}
      {# Flipbook embed — show the online viewer in an iframe #}
      <div class="flipbook-embed" aria-label="Online flipbook viewer for this week's issue">
        <iframe src="{{ latest.flipbook_url }}" title="This week's issue — online viewer" loading="lazy" allowfullscreen></iframe>
      </div>
      <p class="pdf-viewer__hint muted">Prefer the PDF? Use <strong>Open PDF</strong> above.</p>
    {% else %}
      {# Desktop: inline PDF embed. Mobile: hidden via CSS — buttons above handle it. #}
      <div class="pdf-embed" aria-label="PDF viewer for this week's issue">
        <object data="{{ latest.pdf }}#view=FitH" type="application/pdf" class="pdf-embed__object">
          <div class="pdf-embed__fallback">
            <p>Your browser can't display PDFs inline.</p>
            <a class="btn btn--primary" href="{{ latest.pdf }}" target="_blank" rel="noopener">Open the PDF in a new tab</a>
          </div>
        </object>
      </div>
      <p class="pdf-viewer__hint muted">Tip: on a phone or tablet, tap <strong>Open PDF</strong> above for the best reading experience.</p>
    {% endif %}
  </div>
</section>

{% if latest.property_guide.available %}
<section class="property-guide section section--cream">
  <div class="container">
    <p class="eyebrow">Also out now</p>
    <h2>{{ latest.property_guide.title }} — {{ latest.property_guide.date }}</h2>
    <p>Our monthly Coast &amp; Country Property Guide, featuring local real-estate listings and lifestyle property news from across the coast.</p>
    <div class="pdf-actions">
      <a class="btn btn--primary" href="{{ latest.property_guide.pdf }}" target="_blank" rel="noopener">Read the Property Guide ↗</a>
      <a class="btn btn--link" href="{{ latest.property_guide.pdf }}" download>Download PDF</a>
    </div>
  </div>
</section>
{% endif %}

<section class="archive section">
  <div class="container">
    <h2>Previous issues</h2>
    <p class="muted">A few weeks back — for older editions, get in touch.</p>
    <ul class="archive__list" role="list">
      {% for issue in archive.issues %}
        <li class="archive__item">
          <div class="archive__meta">
            <span class="archive__num">Issue {{ issue.number }}</span>
            <span class="archive__date">{{ issue.date | formatDate }}</span>
          </div>
          <div class="archive__actions">
            <a class="btn btn--link" href="{{ issue.pdf }}" target="_blank" rel="noopener">Open ↗</a>
            <a class="btn btn--link" href="{{ issue.pdf }}" download>Download</a>
          </div>
        </li>
      {% endfor %}
    </ul>

    {% if archive.external_archive.enabled %}
      <p class="archive__external">
        <a class="btn btn--ghost" href="{{ archive.external_archive.url }}" target="_blank" rel="noopener">{{ archive.external_archive.label }} ↗</a>
      </p>
    {% endif %}
  </div>
</section>
