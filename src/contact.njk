---
layout: layouts/base.njk
permalink: /contact/
title: "Contact"
description: "Contact the Pōhutukawa Coast Times — newsdesk, advertising, delivery roles and social."
bodyClass: "contact"
---

<section class="page-header section">
  <div class="container">
    <p class="eyebrow">Contact</p>
    <h1>{{ contact.heading }}</h1>
    <p class="page-header__lede">{{ contact.lede }}</p>
  </div>
</section>

<section class="contact-grid section">
  <div class="container">
    <div class="contact-grid__inner">

      <div class="contact-card-tile">
        <p class="eyebrow">Newsdesk</p>
        <h2>{{ site.editor.name }}</h2>
        <p class="muted">{{ site.editor.role }}</p>
        <ul class="contact-card-tile__list" role="list">
          <li><a class="btn btn--primary" href="tel:{{ site.contact.phone_news | replace(' ', '') }}">{{ site.contact.phone_news }}</a></li>
          <li><a class="btn btn--ghost" href="mailto:{{ site.contact.email_news }}">{{ site.contact.email_news }}</a></li>
        </ul>
        <p><a href="/submit/">Or submit a story online →</a></p>
      </div>

      <div class="contact-card-tile">
        <p class="eyebrow">Advertising</p>
        <h2>{{ advertising.manager.name }}</h2>
        <p class="muted">{{ advertising.manager.role }}</p>
        <ul class="contact-card-tile__list" role="list">
          <li><a class="btn btn--primary" href="tel:{{ advertising.manager.phone | replace(' ', '') }}">{{ advertising.manager.phone }}</a></li>
          <li><a class="btn btn--ghost" href="mailto:{{ advertising.manager.email }}">{{ advertising.manager.email }}</a></li>
        </ul>
        <p><a href="/advertising/">See the rate card →</a></p>
      </div>

      <div class="contact-card-tile contact-card-tile--full">
        <p class="eyebrow">Follow</p>
        <h2>Stay in touch</h2>
        <p class="contact-card-tile__socials">
          {% if site.social.facebook %}<a class="btn btn--ghost" href="{{ site.social.facebook }}" target="_blank" rel="noopener">Follow on Facebook ↗</a>{% endif %}
          {% if site.social.instagram %}<a class="btn btn--ghost" href="{{ site.social.instagram }}" target="_blank" rel="noopener">Follow on Instagram ↗</a>{% endif %}
        </p>
      </div>

    </div>
  </div>
</section>

{% if contact.delivery and contact.delivery.heading %}
<section class="delivery section section--cream">
  <div class="container container--narrow">
    <p class="eyebrow">Join the team</p>
    <h2>{{ contact.delivery.heading }}</h2>
    <p>{{ contact.delivery.intro }}</p>

    {% if contact.delivery.email %}
      <p>
        <a class="btn btn--primary" href="mailto:{{ contact.delivery.email }}?subject=Newspaper%20delivery%20role">{{ contact.delivery.email }}</a>
      </p>
    {% endif %}

    {% if contact.delivery.details and contact.delivery.details.length %}
      <ul class="delivery__details" role="list">
        {% for d in contact.delivery.details %}
          <li>{{ d }}</li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</section>
{% endif %}
