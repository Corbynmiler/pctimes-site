---
layout: layouts/base.njk
permalink: /community/
title: "Community Calendar"
description: "Local events, club meetings, fundraisers and community happenings on the Pōhutukawa Coast."
bodyClass: "community"
---

<section class="page-header section">
  <div class="container">
    <p class="eyebrow">Community</p>
    <h1>What's on, on the coast.</h1>
    <p class="page-header__lede">{{ community.intro }}</p>
    {% if community.external.enabled %}
      <div class="pdf-actions">
        <a class="btn btn--primary" href="{{ community.external.url }}" target="_blank" rel="noopener">{{ community.external.label }} ↗</a>
      </div>
    {% endif %}
  </div>
</section>

<section class="events section">
  <div class="container">
    <h2 class="vh">Events &amp; what's on</h2>
    <ul class="events__list" role="list">
      {% for event in community.events %}
        {# A "recurring" event has no date — used for "Mondays" / "Tuesdays" /
           regular weekly activity groups. They render as a full-width card
           with a bullet list rather than a left-column date strip. #}
        {% set isRecurring = not event.date and not event.time %}
        {% set activities = event.description | bulletList %}

        {% if isRecurring %}
          <li class="recurring-card">
            <h3 class="recurring-card__title">{{ event.title }}</h3>
            {% if event.location %}<p class="recurring-card__location muted">📍 {{ event.location }}</p>{% endif %}
            {% if activities.length %}
              <ul class="recurring-card__list" role="list">
                {% for item in activities %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
            {% elif event.description %}
              <p class="recurring-card__body">{{ event.description }}</p>
            {% endif %}
          </li>
        {% else %}
          <li class="event">
            <div class="event__date">
              {% if event.date %}<span class="event__day">{{ event.date | formatDate }}</span>{% endif %}
              {% if event.time %}<span class="event__time">{{ event.time }}</span>{% endif %}
            </div>
            <div class="event__body">
              <h3 class="event__title">{{ event.title }}</h3>
              {% if event.location %}<p class="event__location">📍 {{ event.location }}</p>{% endif %}
              {% if activities.length %}
                <ul class="event__list" role="list">
                  {% for item in activities %}
                    <li>{{ item }}</li>
                  {% endfor %}
                </ul>
              {% elif event.description %}
                <p class="event__desc">{{ event.description }}</p>
              {% endif %}
            </div>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</section>

<section class="community-submit section section--cream">
  <div class="container">
    <h2>Got an event for the calendar?</h2>
    <p>{{ community.submit_note }}</p>
    <a class="btn btn--primary" href="/submit/">Submit your event</a>
  </div>
</section>
